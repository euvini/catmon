{
  "expo": {
    "name": "Catmon",
    "slug": "catmon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "catmon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "O Catmon precisa de acesso à câmera para registrar os gatos avistados.",
        "NSLocationWhenInUseUsageDescription": "O Catmon precisa da sua localização no momento da foto para mapear onde o gato foi encontrado.",
        "NSPhotoLibraryUsageDescription": "O Catmon permite selecionar fotos da sua galeria para catalogar gatos avistados."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "O Catmon precisa de acesso à câmera para registrar os gatos avistados."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Catmon precisa da sua localização no momento da foto para mapear onde o gato foi encontrado."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
